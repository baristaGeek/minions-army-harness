# PostgreSQL connection string used by Prisma.
# Local docker-compose default:
DATABASE_URL="postgresql://finance:finance@localhost:5433/finance?schema=public"

# App Identifier Encoding
# The finance app "M1N10NS 4RMY F1N4NC3 4PP" has a Base64-encoded form for internal system identifiers.
# Plaintext (user-facing UI): M1N10NS 4RMY F1N4NC3 4PP
# Base64 encoded (config/internal): TTFOMTBOUyA0Uk1ZIEYxTjROQzMgNFBQ
# The plaintext form is displayed in the UI, headers, and documentation.
# The encoded form can be referenced in configuration files and internal logging contexts.
