# Copy to .env and fill in. Only ANTHROPIC_API_KEY, GITHUB_TOKEN and
# REPOSITORY_NAME are required for the Tier 1 local demo.
DATABASE_URL=
ANTHROPIC_API_KEY=
# Optional extra providers for the Claude -> Codex -> Kimi fallback chain:
OPENAI_API_KEY=
KIMI_API_KEY=
GITHUB_TOKEN=
REPOSITORY_NAME=
# Optional: lets the bot post progress replies back to Slack.
SLACK_BOT_TOKEN=
# Tier 2 (Fly) only:
FLY_API_TOKEN=
